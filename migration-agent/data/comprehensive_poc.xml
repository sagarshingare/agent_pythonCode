<TRANSFORMATION DESCRIPTION="Source Qualifier for customer data" NAME="SQ_Customer_Data" OBJECTVERSION="1" REUSABLE="NO" TYPE="Source Qualifier" VERSIONNUMBER="1">
<TABLEATTRIBUTE NAME="Sql Query" VALUE="SELECT CUSTOMER_ID, FIRST_NAME, LAST_NAME, EMAIL, PHONE, REGISTRATION_DATE, ACCOUNT_BALANCE, STATUS, CITY, COUNTRY FROM CUSTOMER_DATA" />
</TRANSFORMATION>

<TRANSFORMATION DESCRIPTION="Process customer data with expressions" NAME="EXP_Customer_Processing" OBJECTVERSION="1" REUSABLE="NO" TYPE="Expression" VERSIONNUMBER="1">
<TABLEATTRIBUTE NAME="Tracing Level" VALUE="Normal" />
<TRANSFORMFIELD DATATYPE="number" DEFAULTVALUE="" DESCRIPTION="Unique customer identifier" NAME="CUSTOMER_ID" PICTURETEXT="" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="" DESCRIPTION="Customer first name" NAME="FIRST_NAME" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="50" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="" DESCRIPTION="Customer last name" NAME="LAST_NAME" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="50" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="ERROR('transformation error')" DESCRIPTION="Customer full name" EXPRESSION="CONCAT(CONCAT(FIRST_NAME, ' '), LAST_NAME)" EXPRESSIONTYPE="GENERAL" NAME="FULL_NAME" PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="101" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="" DESCRIPTION="Customer email address" NAME="EMAIL" PICTURETEXT="" PORTTYPE="INPUT/OUTPUT" PRECISION="100" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="" DESCRIPTION="Customer phone number" NAME="PHONE" PICTURETEXT="" PORTTYPE="INPUT" PRECISION="20" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="ERROR('transformation error')" DESCRIPTION="Clean phone number" EXPRESSION="IIF(ISNULL(PHONE), 'N/A', REGEX_REPLACE(PHONE, '[^0-9]', ''))" EXPRESSIONTYPE="GENERAL" NAME="CLEAN_PHONE" PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="20" SCALE="0" />
<TRANSFORMFIELD DATATYPE="date" DEFAULTVALUE="" DESCRIPTION="Customer registration date" NAME="REGISTRATION_DATE" PICTURETEXT="" PORTTYPE="INPUT/OUTPUT" PRECISION="19" SCALE="0" />
<TRANSFORMFIELD DATATYPE="number" DEFAULTVALUE="" DESCRIPTION="Customer account balance" NAME="ACCOUNT_BALANCE" PICTURETEXT="" PORTTYPE="INPUT/OUTPUT" PRECISION="12" SCALE="2" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="" DESCRIPTION="Customer status" NAME="STATUS" PICTURETEXT="" PORTTYPE="INPUT/OUTPUT" PRECISION="10" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="ERROR('transformation error')" DESCRIPTION="Customer segment" EXPRESSION="IIF(ACCOUNT_BALANCE &gt; 50000, 'PREMIUM', IIF(ACCOUNT_BALANCE &gt; 10000, 'GOLD', 'STANDARD'))" EXPRESSIONTYPE="GENERAL" NAME="CUSTOMER_SEGMENT" PICTURETEXT="" PORTTYPE="OUTPUT" PRECISION="20" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="" DESCRIPTION="Customer city" NAME="CITY" PICTURETEXT="" PORTTYPE="INPUT/OUTPUT" PRECISION="50" SCALE="0" />
<TRANSFORMFIELD DATATYPE="varchar2" DEFAULTVALUE="" DESCRIPTION="Customer country" NAME="COUNTRY" PICTURETEXT="" PORTTYPE="INPUT/OUTPUT" PRECISION="50" SCALE="0" />
</TRANSFORMATION>

<TRANSFORMATION DESCRIPTION="Filter active customers only" NAME="FLT_Active_Customers" OBJECTVERSION="1" REUSABLE="NO" TYPE="Filter" VERSIONNUMBER="1">
<TABLEATTRIBUTE NAME="Tracing Level" VALUE="Normal" />
<TABLEATTRIBUTE NAME="Filter Condition" VALUE="STATUS = 'ACTIVE' AND ISNULL(CUSTOMER_ID) = 0" />
